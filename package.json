{
  "name": "life-os",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "ts-node ./node_modules/jest/bin/jest.js --preset=ts-jest",
    "test:watch": "ts-node ./node_modules/jest/bin/jest.js --watch --preset=ts-jest",
    "test:coverage": "ts-node ./node_modules/jest/bin/jest.js --coverage --preset=ts-jest",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate:sqlite",
    "db:migrate": "tsx ./scripts/migrate.ts",
    "db:seed": "tsx ./scripts/seed.ts",
    "db:reset": "rm -f life-os.db && npm run db:migrate && npm run db:seed"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.2.3",
    "@react-navigation/native": "^6.1.9",
    "@react-navigation/native-stack": "^6.9.17",
    "@tanstack/react-query": "^5.59.0",
    "better-sqlite3": "^11.4.0",
    "drizzle-orm": "^0.33.0",
    "expo": "~57.0.25",
    "expo-blur": "~15.0.1",
    "expo-build-properties": "~0.14.1",
    "expo-haptics": "~15.0.1",
    "expo-linear-gradient": "~15.0.1",
    "expo-localization": "~15.0.1",
    "expo-notifications": "~0.28.1",
    "expo-router": "^5.0.7",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~5.0.1",
    "lucide-react-native": "^0.479.0",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.24.0",
    "react-native-reanimated": "~3.16.0",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~3.34.0",
    "zod": "^3.23.8",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^12.9.0",
    "@types/better-sqlite3": "^7.6.11",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "@typescript-eslint/eslint-plugin": "^8.13.0",
    "@typescript-eslint/parser": "^8.13.0",
    "drizzle-kit": "^0.24.2",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^4.6.2",
    "jest": "^29.7.0",
    "prettier": "^3.3.3",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.2",
    "typescript": "~6.0.3"
  },
  "private": true,
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.ts"
    ],
    "testMatch": [
      "**/__tests__/**/*.test.ts",
      "**/*.test.ts"
    ],
    "transform": {
      "^.+\\.(ts|tsx)$": [
        "ts-jest",
        {
          "useESM": true
        }
      ]
    },
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx",
      "json",
      "node"
    ],
    "collectCoverageFrom": [
      "**/*.{ts,tsx}",
      "!**/node_modules/**",
      "!**/coverage/**",
      "!**/__tests__/**"
    ]
  }
}
